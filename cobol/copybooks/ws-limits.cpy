      *> Buffer and structural limits
      *> REQUEST-BUFFER:    4,096 bytes (max HTTP request)
      *> RESPONSE-BUFFER:  65,536 bytes (max HTTP response)
      *> HTML-BODY:        32,768 bytes (max page HTML)
      *> WS-PAGE-CONTENT:  16,384 bytes (max page inner content)
      *> Resources:        20 max (from OpenAPI paths)
      *> Fields/resource:  20 max (from OpenAPI schema)
      *> Field name:       64 chars max
      *> Resource name:    64 chars max
      *> Route ID:         10 chars max
      *> Request path:     512 chars max
      *> Page:             1-999
      *> PerPage:          1-100
